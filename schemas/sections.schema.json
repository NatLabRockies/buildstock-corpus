{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/NatLabRockies/buildstock-corpus/schemas/sections.schema.json",
  "title": "buildstock-corpus release sections",
  "description": "Every heading of every document in one dataset release, with its level and the 1-based line range it spans in the processed markdown file (line 1 is the provenance header). Keyed by corpus path. Generated by `bsc map`; stamps the manifest it describes.",
  "type": "object",
  "additionalProperties": false,
  "required": ["product", "release", "corpus_version", "manifest_sha256", "documents"],
  "properties": {
    "product": { "type": "string", "minLength": 1 },
    "release": { "type": "string", "minLength": 1 },
    "corpus_version": { "type": "string", "minLength": 1 },
    "manifest_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "documents": {
      "type": "object",
      "description": "corpus_path -> the document's headings in file order.",
      "propertyNames": { "pattern": "\\.md$" },
      "additionalProperties": {
        "type": "array",
        "items": { "$ref": "#/$defs/section" }
      }
    }
  },
  "$defs": {
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["heading", "level", "line_start", "line_end"],
      "properties": {
        "heading": { "type": "string" },
        "level": { "type": "integer", "minimum": 1, "maximum": 6 },
        "line_start": { "type": "integer", "minimum": 1, "description": "Line of the heading itself." },
        "line_end": { "type": "integer", "minimum": 1, "description": "Last line before the next heading of any level, or the file's last line." }
      }
    }
  }
}
