# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Test caches
.pytest_cache/

# Pipeline data (regenerable / large; the versioned deliverable is processed/)
raw/
index/

# Sandbox roots for `bsc build --work-dir` smoke tests (partial, throwaway corpora)
.smoketest/

# Transcription working files (page renders, text-layer dumps) used while authoring an
# overlay. The overlay's own pins are what make it re-checkable; these are notes.
.scratch/

# Extracted figure assets under processed/ (~250 MB of binaries, regenerable
# via `bsc fetch && bsc build`). The clean markdown keeps its image references,
# so audit_md_fidelity.py still reports them -- only the binaries are uncommitted.
processed/**/*.png
processed/**/*.PNG
processed/**/*.jpg
processed/**/*.JPG
processed/**/*.jpeg
processed/**/*.svg
processed/**/*.ico
processed/**/*.pdf

# Model caches
.cache/
*.onnx
